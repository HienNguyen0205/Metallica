{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://metallica.local/contracts/visualization.v1.json",
  "title": "VisualizationSpec v1",
  "description": "Canonical renderer contract. Tolerant reader: consumers require only `type`; every other field is optional. Producers SHOULD send title + data. Mirrors src/lib/visualization/types.ts and backend/friday/schemas/visualization.py — any change must update both and the parity tests.",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "radial_gauge",
        "radar",
        "waveform",
        "network",
        "line_3d",
        "bar_3d",
        "globe",
        "timeline",
        "sankey_flow",
        "map"
      ]
    },
    "title": { "type": "string" },
    "animation": { "type": "string", "enum": ["materialize", "pulse", "none"] },
    "interaction": { "type": "string", "enum": ["none", "drill_down"] },
    "theme": {
      "type": "object",
      "properties": {
        "color": { "type": "string" },
        "accent": { "type": "string" }
      },
      "additionalProperties": false
    },
    "position": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "scale": { "type": "number" },
    "data": { "$ref": "#/definitions/VizData" },
    "answer": { "type": "string" }
  },
  "definitions": {
    "MetricDatum": {
      "type": "object",
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "number" },
        "unit": { "type": "string" }
      }
    },
    "SeriesDatum": {
      "type": "object",
      "required": ["label", "points"],
      "properties": {
        "label": { "type": "string" },
        "points": { "type": "array", "items": { "type": "number" } }
      }
    },
    "NodeDatum": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "GeoPoint": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "label": { "type": "string" },
        "id": { "type": "string" },
        "value": { "type": "number" },
        "status": { "type": "string", "enum": ["healthy", "warning", "critical", "offline"] },
        "color": { "type": "string" },
        "metadata": { "type": "object" }
      }
    },
    "GlobeRoute": {
      "type": "object",
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": ["string", "number"] },
        "to": { "type": ["string", "number"] },
        "value": { "type": "number" },
        "latencyMs": { "type": "number" },
        "status": { "type": "string", "enum": ["healthy", "warning", "critical"] }
      }
    },
    "TimelineEvent": {
      "type": "object",
      "required": ["label", "at"],
      "properties": {
        "label": { "type": "string" },
        "at": { "type": "number" }
      }
    },
    "LatLon": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "MapRoute": {
      "type": "object",
      "required": ["waypoints"],
      "properties": {
        "profile": { "type": "string", "enum": ["auto", "motor_scooter", "bicycle", "pedestrian"], "default": "motor_scooter" },
        "waypoints": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["lat", "lon"],
            "properties": {
              "lat": { "type": "number", "minimum": -90, "maximum": 90 },
              "lon": { "type": "number", "minimum": -180, "maximum": 180 },
              "label": { "type": "string" }
            }
          }
        }
      }
    },
    "MapView": {
      "type": "object",
      "description": "Camera and route intent for a `map` visualization. A route carries waypoints only; the map fetches geometry from /geo/route.",
      "properties": {
        "center": { "$ref": "#/definitions/LatLon" },
        "zoom": { "type": "number", "minimum": 0, "maximum": 20 },
        "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "[west, south, east, north]" },
        "route": { "$ref": "#/definitions/MapRoute" }
      }
    },
    "VizData": {
      "type": "object",
      "description": "Every field optional: each renderer reads only the ones it needs.",
      "properties": {
        "metrics": { "type": "array", "items": { "$ref": "#/definitions/MetricDatum" } },
        "series": { "type": "array", "items": { "$ref": "#/definitions/SeriesDatum" } },
        "nodes": { "type": "array", "items": { "$ref": "#/definitions/NodeDatum" } },
        "links": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 }
        },
        "points": { "type": "array", "items": { "$ref": "#/definitions/GeoPoint" } },
        "routes": { "type": "array", "items": { "$ref": "#/definitions/GlobeRoute" } },
        "map": { "$ref": "#/definitions/MapView" },
        "events": { "type": "array", "items": { "$ref": "#/definitions/TimelineEvent" } },
        "rate": { "type": "number" }
      }
    }
  }
}
