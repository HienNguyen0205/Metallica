# Copy to .env.local for local development. Both are read at BUILD time:
# NEXT_PUBLIC_* values are inlined into the bundle, so changing one means
# rebuilding, not just restarting.

# Orchestrator base URL. No trailing slash.
#   local backend  http://localhost:8000
#   deployed       https://metallica-be.onrender.com
# When unreachable the UI falls back to the local rules planner in
# src/lib/vizPlanner.ts, which serves canned demo data — so a wrong value here
# looks like a working site rather than a broken one.
NEXT_PUBLIC_FRIDAY_API=http://localhost:8000

# Set to 1 to opt the scene into a WebGPU renderer (falls back to WebGL2).
# NEXT_PUBLIC_WEBGPU=1
