# Copy to .env and fill in. .env is gitignored — never commit a real key.

# ---- Provider (§8 model gateway) ----------------------------------------
# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Everything below is optional; the defaults target Gemini's free tier.
#
# The gateway speaks the OpenAI dialect, so any compatible provider works —
# only these two lines change. Budget 2-3 model calls per user query, so
# requests-per-minute limits matter more than token limits.
#
#   Groq       https://api.groq.com/openai/v1          llama-3.3-70b-versatile
#   Cerebras   https://api.cerebras.ai/v1              llama-3.3-70b
#   OpenRouter https://openrouter.ai/api/v1            <model>:free
#   Ollama     http://localhost:11434/v1               llama3.1   (no key)
#
# FRIDAY_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Defaults to gemini-3.5-flash-lite: fastest of the working models and, more
# importantly, not quota-starved. The free daily quota is PER MODEL, and
# gemini-3.6-flash allows only 20 requests/day — about six questions, since a
# query costs 2-3 model calls. Check the 429 body for the real number:
#   quotaId: GenerateRequestsPerDayPerProjectPerModel-FreeTier
# FRIDAY_LLM_MODEL=gemini-3.5-flash-lite

# Generic key name — wins over GEMINI_API_KEY. Use this when pointing at a
# provider that is not Gemini, so the variable name is not a lie.
# FRIDAY_LLM_API_KEY=

# ---- Service -------------------------------------------------------------
# Comma-separated CORS allowlist. Deliberately not a wildcard: any page on the
# machine could otherwise drive the agent.
# FRIDAY_ALLOWED_ORIGINS=http://localhost:3000
# Seconds before an unanswered high-risk approval expires (silence is not consent).
# FRIDAY_CONFIRM_TIMEOUT_S=120

# ---- P1.9 durable run state -----------------------------------------------
# memory (default): process-local snapshots, same lifecycle as the registry.
# redis: snapshots in Redis (readable from any worker); needs the redis
# package (pip install redis) and a server. Single writer per run — runs are
# owned by the worker streaming them; approval *waits* stay process-local
# until reconnect lands (P1.10).
# FRIDAY_STATE_BACKEND=memory
# FRIDAY_REDIS_URL=redis://localhost:6379/0

# ---- P1.8 capability grants ------------------------------------------------
# Comma-separated capabilities this deployment grants every session; calls
# needing more are denied before they run. "*" (default) grants everything.
# Example least-privilege: system.read,web.read,notes.read
# FRIDAY_GRANTED_CAPABILITIES=*

# ---- P3 identity + audit ---------------------------------------------------
# Identity headers count ONLY in trust mode (a proxy must strip them first —
# blindly trusting a client header lets anyone be anyone). Default off:
# everyone is anonymous and session_id stays the working boundary.
# FRIDAY_TRUST_IDENTITY_HEADERS=false
# (Identity header is X-User-Id, bound in api/routes.py — no custom-name var.)

# ---- P4 filesystem sandbox -------------------------------------------------
# Root for list_dir/read_file (default backend/notes/). Sensitive basenames
# (.env*, *.pem, *credential*, *secret*) are refused wherever the root points.
# FRIDAY_SANDBOX_DIR=./notes

# ---- P4 docs RAG -----------------------------------------------------------
# Corpus root and disk cache for search_docs. Defaults are docs/ and
# backend/.rag_index.json (gitignored); the cache rebuilds when files change.
# FRIDAY_DOCS_ROOT=./docs
# FRIDAY_RAG_CACHE=./.rag_index.json

# ---- P3 observability ------------------------------------------------------
# Optional per-1M-token [input, output] USD prices for the cost estimate.
# Unset means costs record 0.0 — unknown, never guessed.
# FRIDAY_MODEL_PRICES_JSON={"gemini-3.5-flash-lite": [0.1, 0.2]}

# ---- §22 abuse caps ------------------------------------------------------
# /query is public and every call spends provider quota, so it is capped twice:
# per caller, and across all callers. The second one is the one that holds —
# the first is keyed on X-Forwarded-For, which anyone can forge.
#
# Defaults suit a free-tier key: a query costs 2-3 model calls, so 100/hour
# sustained is already a day's quota. Raise once the key has a budget.
# FRIDAY_RATE_LIMIT_PER_HOUR=30
# FRIDAY_GLOBAL_LIMIT_PER_HOUR=100

# ---- §10 web search -----------------------------------------------------
# Tavily only. Without a key search_web returns an error. The free tier is a
# fixed credit balance (1000), not a daily allowance: once spent, it stays spent.

# https://app.tavily.com — free tier, no card.
# TAVILY_API_KEY=tvly-...
# A second Tavily account is a second balance, tried when the first returns 401.
# It doubles the runway; it does not make it renewable, and multiplying a free
# tier across accounts is against most providers' terms — check Tavily's first.
# TAVILY_API_KEY_2=tvly-...

# ---- Ký ức dài hạn ------------------------------------------------------
# Chưa đặt thì FRIDAY chạy bình thường, chỉ không có ký ức bền — nó log một
# dòng lúc khởi động rồi thôi.
#
# Chạy backend/supabase_schema.sql trong SQL editor của project trước.
#
# SUPABASE_SERVICE_KEY bỏ qua mọi RLS. Nó chỉ được đọc ở backend; đừng bao giờ
# đặt tên biến bắt đầu bằng NEXT_PUBLIC_ cho nó.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=

# Quota embedding tách khỏi 15 RPM của generate_content — đã đo, và cả thiết
# kế recall mỗi turn đứng trên điều đó. Đổi provider thì đo lại.
# FRIDAY_EMBED_MODEL=gemini-embedding-001

# Street map search + directions (spec 2026-09-21 §6) — TomTom, https://developer.tomtom.com
# Enable Search, Places, Reverse Geocoding and Routing on this key; it never
# reaches the browser (the browser key is NEXT_PUBLIC_TOMTOM_MAP_KEY, Map
# Display only). Unset: the map works but search/directions say unconfigured.
# Free allowances are per API per month; fuzzy search (agent find_place) is
# only 2.5K/month.
# TOMTOM_API_KEY=
