{
  "name": "metallica",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:frontend": "next dev",
    "dev:backend": "python -m uvicorn friday.main:app --port 8000 --reload --app-dir backend",
    "dev:full": "node -e \"const{spawn}=require('child_process');for(const a of[['run','dev:backend'],['run','dev:frontend']]){const p=spawn('npm',a,{stdio:'inherit',shell:true});p.on('exit',c=>{if(c)process.exit(c)})}\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:frontend": "playwright test --project=unit",
    "test:backend": "python backend/runtests.py",
    "test:contracts": "playwright test --project=unit tests/unit/contracts.spec.ts tests/unit/eventContract.spec.ts tests/unit/envelopedFlow.spec.ts && python backend/runtests.py test_contracts",
    "test:e2e": "playwright test --project=ui",
    "test:ui": "playwright test --project=ui",
    "test:headed": "playwright test --project=ui --headed",
    "test:debug": "playwright test --project=ui --debug",
    "test:report": "playwright show-report",
    "verify": "npm run lint && npm run typecheck && npm run test:frontend && npm run test:backend && npm run test:contracts && npm run test:e2e"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "next": "^16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
